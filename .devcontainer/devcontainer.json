{
  "name": "Programming Practice (Python + R)",

  "image": "ghcr.io/rocker-org/devcontainer/r-ver:4.6",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "leetcode.vscode-leetcode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "REditorSupport.r"
      ],

      "settings": {
        "leetcode.defaultLanguage": "python3",
        "leetcode.workspaceFolder": "${workspaceFolder}/python/solutions",

        "python.languageServer": "Pylance",
        "python.analysis.typeCheckingMode": "basic",

        "r.rpath.linux": "/usr/local/bin/R",

        "editor.formatOnSave": true,
        "workbench.colorTheme": "Dark Modern"
      }
    }
  },

  "postCreateCommand": "R -q -e \"install.packages(c('languageserver', 'Rlab', 'tidyverse', 'igraph'), repos='https://cloud.r-project.org')\"",

  "remoteUser": "vscode"
}